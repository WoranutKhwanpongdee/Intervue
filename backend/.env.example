# Database Configuration
# Default PostgreSQL (or falls back automatically to SQLite if PostgreSQL is unreachable)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intervue_db
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./intervue.db

# LLM Provider Selection
# Options: "auto" | "gemini" | "groq" | "ollama" | "mock"
# Default is "auto", which uses Gemini or Groq if keys are present, or falls back to "mock" for zero-friction testing.
LLM_PROVIDER=auto

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Application Settings
DEBUG=false
